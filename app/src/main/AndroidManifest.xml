<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK: 기획 기능에 필요한 도메인만 선언 (CAR_* = 조회/리스너, CONTROL_CAR_* = 제어) -->
    <!-- Seat: 등받이·위치 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <!-- HVAC, SteeringWheel 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- Light: 앰비언트 라이트 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- Window: 환기용 개방 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- AAOS Car API: GEAR_SELECTION, PARKING_BRAKE_ON (정차 조건 감시) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS Car API: INFO_FUEL_TYPE (엔진차/전기차 구분) -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- AAOS Car API: EV_CHARGE_STATE·남은 충전 시간·충전 한도 (충전 대기). dangerous 권한이라 실행 중에 요청한다. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <!-- EvBattery: 배터리 잔량·충전 상태 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- FusedLocation SDK -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- NaviHelper SDK: 기상 후 경로 안내 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 에뮬레이터 전용: 기기 안 Virtual Console(127.0.0.1:8088)에서 시트 위치를 읽는다(EmulatorSeat). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chabun">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- distractionOptimized를 선언하지 않으므로 주행 중에는 시스템이 화면을 차단합니다(정차 중 전용 앱). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
